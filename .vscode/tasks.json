{
	// Fast tasks for rapid iteration on ESP32 AP flasher
	"version": "2.0.0",
	"tasks": [
		{
			"label": "FAST: Build OutdoorAP (Turbo)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/ESP32_AP-Flasher"
			},
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-Date -Format o; python fast_compile.py --env OutdoorAP --jobs 16"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "FAST: Upload OutdoorAP (COM10 Turbo)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/ESP32_AP-Flasher"
			},
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-Date -Format o; ./fast_compile.ps1 -Environment OutdoorAP -ComPort COM10 -BaudRate 921600 -SkipBuild -Monitor"
			],
			"problemMatcher": []
		},
		{
			"label": "FAST: Build+Upload OutdoorAP (COM10 Turbo)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/ESP32_AP-Flasher"
			},
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-Date -Format o; ./fast_compile.ps1 -Environment OutdoorAP -ComPort COM10 -BaudRate 921600"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "FAST: Upload FS Only (COM10)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/ESP32_AP-Flasher"
			},
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-Date -Format o; ./fast_compile.ps1 -Environment OutdoorAP -ComPort COM10 -BaudRate 921600 -FilesystemOnly"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "PIO: Build OutdoorAP",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/ESP32_AP-Flasher"
			},
			"command": "pio",
			"args": [
				"run",
				"-e",
				"OutdoorAP"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "PIO: Upload OutdoorAP (auto)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/ESP32_AP-Flasher"
			},
			"command": "pio",
			"args": [
				"run",
				"-e",
				"OutdoorAP",
				"-t",
				"upload"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "PIO: Upload OutdoorAP (choose port)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/ESP32_AP-Flasher"
			},
			"command": "pio",
			"args": [
				"run",
				"-e",
				"OutdoorAP",
				"-t",
				"upload",
				"--upload-port",
				"${input:uploadPort}"
			],
			"problemMatcher": []
		},
		{
			"label": "PIO: Monitor (choose port)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"command": "pio",
			"args": [
				"device",
				"monitor",
				"--baud",
				"115200",
				"--port",
				"${input:monitorPort}"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "PIO: Monitor (COM10)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"command": "pio",
			"args": [
				"device",
				"monitor",
				"--baud",
				"115200",
				"--port",
				"COM10"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "QEMU: Start (OutdoorAP)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/ESP32_AP-Flasher"
			},
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/ESP32_AP-Flasher/emulation_setup.ps1",
				"qemu",
				"-Environment",
				"OutdoorAP"
			],
			"problemMatcher": []
		},
		{
			"label": "build",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"group": "build"
		},
		{
			"label": "build: ESP32_AP-Flasher OutdoorAP",
			"type": "shell",
			"command": "pio",
			"args": [
				"run",
				"-e",
				"OutdoorAP"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"label": "pio build OutdoorAP",
			"type": "shell",
			"command": "pio",
			"args": [
				"run",
				"-e",
				"OutdoorAP"
			],
			"group": "build"
		},
		{
			"label": "PIO: Upload OutdoorAP (choose port) - COM10",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/ESP32_AP-Flasher"
			},
			"command": "pio",
			"args": [
				"run",
				"-e",
				"OutdoorAP",
				"-t",
				"upload",
				"--upload-port",
				"COM10"
			],
			"group": "build"
		},
		{
			"label": "Start web-ui server",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-Date -Format o; node ESP32_AP-Flasher/web-ui/server.js"
			]
		}
	],
	"inputs": [
		{
			"id": "uploadPort",
			"type": "promptString",
			"description": "Enter upload serial port (e.g. COM10)",
			"default": "COM10"
		},
		{
			"id": "monitorPort",
			"type": "promptString",
			"description": "Enter monitor serial port (e.g. COM10)",
			"default": "COM10"
		}
	]
}
