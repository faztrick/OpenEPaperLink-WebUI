{
    // ESP32 Development and Emulation Configuration
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 0}",
    // ESP32 Emulation settings
    "platformio-ide.useBuiltinPIOCore": false,
    "platformio-ide.useDevelopmentPIOCore": false,
    "platformio-ide.autoRebuildAutocompleteIndex": true,
    "platformio-ide.enableTelemetry": false,
    // Debugging configuration for emulation
    "debug.allowBreakpointsEverywhere": true,
    "debug.openDebug": "openOnDebugBreak",
    "debug.showInStatusBar": "onFirstSessionStart",
    "debug.terminal.clearBeforeReusing": true,
    // ESP32 toolchain paths
    "cortex-debug.gdbPath": "C:/Users/faztrick/.platformio/packages/toolchain-xtensa-esp32s3/bin/xtensa-esp32s3-elf-gdb.exe",
    "cortex-debug.armToolchainPath": "C:/Users/faztrick/.platformio/packages/toolchain-xtensa-esp32s3/bin/",
    // Wokwi ESP32 emulator configuration
    "wokwi.projects.directory": "${workspaceFolder}/wokwi",
    "wokwi.gdb.enabled": true,
    "wokwi.gdb.port": 3334,
    // Terminal environment for ESP32 tools
    "terminal.integrated.env.windows": {
        "PLATFORMIO_CORE_DIR": "C:/Users/faztrick/.platformio",
        "PLATFORMIO_PACKAGES_DIR": "C:/Users/faztrick/.platformio/packages",
        "ESP_IDF_PATH": "C:/Users/faztrick/.platformio/packages/framework-espidf",
        "IDF_PATH": "C:/Users/faztrick/.platformio/packages/framework-espidf",
        "IDF_TARGET": "esp32s3"
    },
    // File associations
    "files.associations": {
        "array": "cpp",
        "atomic": "cpp",
        "*.tcc": "cpp",
        "bitset": "cpp",
        "cctype": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "map": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "regex": "cpp",
        "string": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "fstream": "cpp",
        "initializer_list": "cpp",
        "iomanip": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "new": "cpp",
        "ostream": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "cinttypes": "cpp",
        "typeinfo": "cpp",
        "chrono": "cpp",
        "ratio": "cpp",
        "*.ino": "cpp",
        "*.h": "c",
        "*.c": "c",
        "*.cpp": "cpp",
        "*.hpp": "cpp",
        "platformio.ini": "ini",
        "*.gdb": "gdb",
        "gdbinit": "gdb",
        "thread": "cpp"
    },
    // IntelliSense configuration for ESP32
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.default.configurationProvider": "platformio-ide.platformio-ide",
    "C_Cpp.default.compilerPath": "C:/Users/faztrick/.platformio/packages/toolchain-xtensa-esp32s3/bin/xtensa-esp32s3-elf-gcc.exe",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.cppStandard": "c++17",
    // Search and indexing optimization
    "search.exclude": {
        "**/build": true,
        "**/.pio": true,
        "**/node_modules": true,
        "**/esp-idf": true
    },
    "files.exclude": {
        "**/.pio/build": true,
        "**/.pio/libdeps": true
    },
    // ESP-IDF settings (preserved from original)
    "idf.currentSetup": "C:\\Users\\faztrick\\esp\\v5.3.1\\esp-idf",
    "idf.portWin": "COM10",
    "idf.openOcdConfigs": [
        "board/esp32s3-builtin.cfg"
    ],
    "idf.customExtraVars": {
        "IDF_TARGET": "esp32s3"
    },
    "idf.flashType": "UART",
    // Code formatting
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    // Disable unwanted extensions for this workspace
    "extensions.ignoreRecommendations": true,
    // Enable Python for this workspace
    "python.defaultInterpreterPath": "python",
    "python.languageServer": "Pylance",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.formatting.provider": "none",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "java.enabled": false,
    // Disable Jupyter functionality
    "jupyter.askForKernelRestart": false,
    "jupyter.enableExtendedKernelCompletions": false,
    "jupyter.experiments.enabled": false,
    "jupyter.generateSVGPlots": false,
    "jupyter.interactiveWindow.creationMode": "perFile",
    "jupyter.notebookFileRoot": "",
    "jupyter.showCellInputCode": false,
    "jupyter.showVariableViewWhenDebugging": false,
    "jupyter.useNotebookEditor": false,
    "jupyter.widgetScriptSources": [],
    // Disable auto-updates for better stability
    "extensions.autoUpdate": false,
    "extensions.autoCheckUpdates": false,
    "jupyter.interactiveWindow.textEditor.executeSelection": false
}
