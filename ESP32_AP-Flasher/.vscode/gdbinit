# ESP32 GDB Initialization Script for Emulation
# This script sets up GDB for ESP32 debugging with emulators

# Set target architecture
set architecture xtensa

# Enable pretty printing
set print pretty on
set print object on
set print static-members on
set print vtbl on
set print demangle on
set demangle-style gnu-v3

# ESP32 specific memory layout
# Flash memory starts at 0x40000000
# IRAM starts at 0x40080000  
# DRAM starts at 0x3FFB0000
# RTC memory starts at 0x50000000

# Define convenience functions for ESP32
define esp32-reset
    monitor reset halt
    thbreak app_main
    continue
end

define esp32-restart
    monitor reset
    thbreak setup
    continue
end

define esp32-flash-info
    info mem
    print "Flash: 0x40000000-0x40400000"
    print "IRAM:  0x40080000-0x400A0000"  
    print "DRAM:  0x3FFB0000-0x40000000"
    print "RTC:   0x50000000-0x50002000"
end

# ESP32 interrupt and exception handling
define esp32-bt-all
    info threads
    thread apply all bt
end

# Set up for QEMU connection
define connect-qemu
    target extended-remote localhost:3333
    monitor reset halt
    load
    break app_main
end

# Set up for Wokwi connection  
define connect-wokwi
    target extended-remote localhost:3334
    break app_main
end

# Common ESP32 breakpoints
define esp32-common-breaks
    break esp_restart
    break abort
    break panic_abort
    break _esp_error_check_failed
end

# Memory watch helpers
define watch-heap
    watch *((uint32_t*)0x3FFE0000)
end

define watch-stack
    watch $sp
end

# Configure for ESP32-S3 specifics
set $esp32s3_gpio_base = 0x60004000
set $esp32s3_uart_base = 0x60000000
set $esp32s3_spi_base = 0x60002000

# Auto-load symbol file if available
# symbol-file .pio/build/OutdoorAP/firmware.elf

# Default setup
echo ESP32 GDB script loaded\n
echo Available commands:\n
echo - connect-qemu: Connect to QEMU emulator\n
echo - connect-wokwi: Connect to Wokwi simulator\n  
echo - esp32-reset: Reset and break at app_main\n
echo - esp32-common-breaks: Set common ESP32 breakpoints\n
echo - esp32-flash-info: Show memory layout\n
