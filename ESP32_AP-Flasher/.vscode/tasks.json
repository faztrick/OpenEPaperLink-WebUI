{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OutdoorAP",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "OutdoorAP"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$platformio"
        },
        {
            "label": "Clean Build OutdoorAP",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "OutdoorAP",
                "-t",
                "clean"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$platformio"
        },
        {
            "label": "Upload OutdoorAP",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "OutdoorAP",
                "-t",
                "upload"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$platformio"
        },
        {
            "label": "Monitor OutdoorAP",
            "type": "shell",
            "command": "pio",
            "args": [
                "device",
                "monitor",
                "-e",
                "OutdoorAP"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "ESP32-S3 GDB Debug Server",
            "type": "shell",
            "command": "xtensa-esp32s3-elf-gdb",
            "args": [
                "-x",
                "${workspaceFolder}/.vscode/gdbinit",
                "${workspaceFolder}/.pio/build/OutdoorAP/firmware.elf"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".*",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Starting.*",
                    "endsPattern": ".*listening.*"
                }
            }
        }
    ]
}
