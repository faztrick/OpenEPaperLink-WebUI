# Base URL of the ESP32 Access Point API.
# In dev you can point directly to the device IP (same subnet) or leave blank to use window.location.
# Example: http://192.168.4.1
NEXT_PUBLIC_AP_BASE_URL=

# If you run the legacy Express/Node bridge locally, you might set:
# NEXT_PUBLIC_AP_BASE_URL=http://localhost:8080

# Enable mock mode (fallback data if backend not reachable)
NEXT_PUBLIC_USE_MOCK=0
