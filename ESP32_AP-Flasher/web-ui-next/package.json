{
  "name": "open-epaperlink-web-ui-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:serial": "cross-env ENABLE_SERIAL_API=1 next dev",
    "serial:service": "node serial-sidecar/serial-service.js",
    "dev:with-sidecar": "cross-env ENABLE_SERIAL_API=0 SERIAL_SIDECAR_URL=http://localhost:4001 next dev",
    "dev:inspect": "node --inspect=0.0.0.0:9230 node_modules/next/dist/bin/next dev",
    "prebuild": "node scripts/auto_stop_next.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pm2:dev": "pm2 start ecosystem.config.cjs --only webui-dev --watch",
    "pm2:prod": "pm2 start ecosystem.config.cjs --only webui-prod",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-serial.mjs",
    "export:static": "next build && next export",
    "export:copy": "node scripts/export-static-and-copy.mjs",
    "export:all": "node scripts/export-static-and-copy.mjs --clean"
  },
  "dependencies": {
    "next": "15.5.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "serialport": "13.0.0",
    "swr": "2.3.6"
  },
  "devDependencies": {
    "@types/node": "22.8.1",
    "@types/react": "19.1.11",
    "cross-env": "^7.0.3",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.0",
    "pm2": "5.4.2",
    "typescript": "5.9.2",
    "vitest": "1.6.0"
  }
}
