# PlatformIO build files
.pio
.pio/
build/
*.bin
*.elf
*.map

# VS Code settings (keep some but not all)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ESP32 build artifacts
sdkconfig.old
sdkconfig.bak
menuconfig/

# Build directories and artifacts
build/
dist/
out/
*.o
*.a
*.so
*.dll
*.exe

# Sensitive configuration files
*config*.json
openai_config*.json
*_config.json
api_keys.txt
credentials.txt
secrets.txt

# Exception: Allow template files
!*template*.json
!*.template.json

# Environment files
.env
.env.local
.env.production
.env.development

# Log files
*.log
logs/
log/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Node.js (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if any)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Backup files
*.bak
*.backup
*_backup.*

# Dependencies lock files that might contain sensitive info
dependencies.lock
